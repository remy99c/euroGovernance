# ==============================================================================
# euroGovernance Web Client - Environment Configuration
# ==============================================================================

# Toggle Firebase Local Emulator Connection (true for local dev, false for cloud)
NEXT_PUBLIC_USE_FIREBASE_EMULATOR=true

# Exposes well-known emulator-only persona credentials in non-production builds.
# Keep false unless the local Auth emulator has been seeded for persona testing.
NEXT_PUBLIC_ENABLE_DEV_PERSONAS=false

# Optional Auth-emulator persona credentials. These are intentionally not
# defaulted in application code and must never reference production accounts.
NEXT_PUBLIC_DEV_PERSONA_PASSWORD=
NEXT_PUBLIC_DEV_PERSONA_TENANT_ADMIN_EMAIL=
NEXT_PUBLIC_DEV_PERSONA_COMPLIANCE_MANAGER_EMAIL=
NEXT_PUBLIC_DEV_PERSONA_SECURITY_MANAGER_EMAIL=
NEXT_PUBLIC_DEV_PERSONA_PRIVACY_MANAGER_EMAIL=
NEXT_PUBLIC_DEV_PERSONA_AI_GOVERNANCE_MANAGER_EMAIL=
NEXT_PUBLIC_DEV_PERSONA_APPROVER_EMAIL=
NEXT_PUBLIC_DEV_PERSONA_AUDITOR_EMAIL=
NEXT_PUBLIC_DEV_PERSONA_CONTRIBUTOR_EMAIL=

# Firebase Project Configuration (Default Emulator Project ID)
NEXT_PUBLIC_FIREBASE_PROJECT_ID=eurogovernance-dev
NEXT_PUBLIC_FIREBASE_API_KEY=demo-api-key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=eurogovernance-dev.firebaseapp.com
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=eurogovernance-dev.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=123456789012
NEXT_PUBLIC_FIREBASE_APP_ID=1:123456789012:web:abcdef123456

# Callable Functions region (must match functions/src/index.ts in cloud and emulator)
NEXT_PUBLIC_FIREBASE_FUNCTIONS_REGION=europe-west3
