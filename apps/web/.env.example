# ==============================================================================
# euroGovernance Web Client - Environment Configuration
# ==============================================================================

# Toggle Firebase Local Emulator Connection (true for local dev, false for cloud)
NEXT_PUBLIC_USE_FIREBASE_EMULATOR=true

# Firebase Project Configuration (Default Emulator Project ID)
NEXT_PUBLIC_FIREBASE_PROJECT_ID=eurogovernance-dev
NEXT_PUBLIC_FIREBASE_API_KEY=demo-api-key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=eurogovernance-dev.firebaseapp.com
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=eurogovernance-dev.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=123456789012
NEXT_PUBLIC_FIREBASE_APP_ID=1:123456789012:web:abcdef123456

# Region Override (EU Frankfurt Residency)
NEXT_PUBLIC_FIREBASE_REGION=europe-west3
