{
  "name": "@eurogovernance/functions",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "watch": "tsc --watch",
    "serve": "firebase emulators:start --only functions",
    "shell": "firebase functions:shell"
  },
  "engines": {
    "node": "22"
  },
  "dependencies": {
    "@eurogovernance/shared-types": "file:vendor/shared-types",
    "firebase-admin": "14.3.0",
    "firebase-functions": "7.3.2"
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "typescript": "^5.4.5"
  },
  "overrides": {
    "gaxios": "7.3.1",
    "firebase-admin": {
      "@google-cloud/storage": {
        ".": "8.0.1",
        "teeny-request": "11.0.1"
      }
    }
  }
}
