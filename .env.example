# ==============================================================================
# euroGovernance Monorepo Root - Environment Configuration Template
# ==============================================================================

# Node Environment
NODE_ENV=development

# Google Cloud & Firebase Project
GCLOUD_PROJECT=eurogovernance-dev
FIREBASE_CONFIG={"projectId":"eurogovernance-dev","storageBucket":"eurogovernance-dev.appspot.com"}

# Local Firebase Emulator Host Bindings (used by scripts & tests)
FIRESTORE_EMULATOR_HOST=127.0.0.1:8080
FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099
FIREBASE_STORAGE_EMULATOR_HOST=127.0.0.1:9199
FUNCTIONS_EMULATOR_HOST=127.0.0.1:5001

# Primary Cloud Region
FIREBASE_REGION=europe-west3
