rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    // Default Deny
    match /{allPaths=**} {
      allow read, write: if false;
    }

    // Evidence artifact client access is disabled. The next milestone introduces
    // server-authorized upload/download commands. Storage Rules cannot verify live Firestore
    // membership state, so custom claims are not accepted as an authorization
    // boundary here. Cloud Functions using the Admin SDK bypass these rules.
    match /tenants/{tenantId}/evidence/{evidenceId}/{fileName} {
      allow read, write: if false;
    }

    // Export artifact client access is disabled until signed downloads exist.
    match /tenants/{tenantId}/exports/{exportId}/{fileName} {
      allow read, write: if false;
    }
  }
}
