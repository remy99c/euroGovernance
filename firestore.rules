rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Default Deny All
    match /{document=**} {
      allow read, write: if false;
    }

    // -------------------------------------------------------------------------
    // Helper Functions
    // -------------------------------------------------------------------------

    function isAuthenticated() {
      return request.auth != null && request.auth.uid != null;
    }

    function isUser(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isPlatformAdmin() {
      return isAuthenticated() &&
        ('platform_admin' in request.auth.token && request.auth.token.platform_admin == true);
    }

    function membershipPath(tenantId) {
      return /databases/$(database)/documents/tenants/$(tenantId)/memberships/$(request.auth.uid);
    }

    function tenantPath(tenantId) {
      return /databases/$(database)/documents/tenants/$(tenantId);
    }

    function isTenantActive(tenantId) {
      return exists(tenantPath(tenantId)) &&
             get(tenantPath(tenantId)).data.get('status', '') == 'active';
    }

    function getMembership(tenantId) {
      return exists(membershipPath(tenantId)) ? get(membershipPath(tenantId)).data : null;
    }

    function isTenantMember(tenantId) {
      return isAuthenticated() && (
        isPlatformAdmin() ||
        (isTenantActive(tenantId) &&
         exists(membershipPath(tenantId)) &&
         get(membershipPath(tenantId)).data.get('status', '') == 'active')
      );
    }

    function isTenantAdmin(tenantId) {
      return isAuthenticated() && (
        isPlatformAdmin() ||
        (isTenantActive(tenantId) &&
         exists(membershipPath(tenantId)) &&
         get(membershipPath(tenantId)).data.get('status', '') == 'active' &&
         get(membershipPath(tenantId)).data.get('role', '') == 'tenant_admin')
      );
    }

    function hasAnyRole(tenantId, roles) {
      return isAuthenticated() && (
        isPlatformAdmin() ||
        (isTenantActive(tenantId) &&
         exists(membershipPath(tenantId)) &&
         get(membershipPath(tenantId)).data.get('status', '') == 'active' &&
         roles.hasAny([get(membershipPath(tenantId)).data.get('role', '')]))
      );
    }

    function validPersonalOnboardingState(tenantId, onboardingUserId) {
      return isAuthenticated() &&
             request.auth.uid == onboardingUserId &&
             exists(membershipPath(tenantId)) &&
             request.resource.data.keys().hasOnly([
               'userId', 'tenantId', 'role', 'status', 'currentStepId',
               'currentStepIndex', 'completedStepIds', 'totalSteps', 'stepData',
               'hasDismissedBanner', 'startedAt', 'completedAt', 'lastActiveAt'
             ]) &&
             request.resource.data.keys().hasAll([
               'userId', 'tenantId', 'role', 'status', 'currentStepId',
               'currentStepIndex', 'completedStepIds', 'totalSteps',
               'hasDismissedBanner', 'startedAt', 'lastActiveAt'
             ]) &&
             request.resource.data.userId == onboardingUserId &&
             request.resource.data.tenantId == tenantId &&
             request.resource.data.role == get(membershipPath(tenantId)).data.get('role', '') &&
             ['not_started', 'in_progress', 'completed', 'dismissed'].hasAny([request.resource.data.status]) &&
             request.resource.data.currentStepId is string &&
             request.resource.data.currentStepId.size() > 0 &&
             request.resource.data.currentStepId.size() <= 128 &&
             request.resource.data.currentStepIndex is int &&
             request.resource.data.currentStepIndex >= 0 &&
             request.resource.data.currentStepIndex < 100 &&
             request.resource.data.completedStepIds is list &&
             request.resource.data.completedStepIds.size() <= 100 &&
             request.resource.data.totalSteps is int &&
             request.resource.data.totalSteps > 0 &&
             request.resource.data.totalSteps <= 100 &&
             request.resource.data.currentStepIndex < request.resource.data.totalSteps &&
             request.resource.data.hasDismissedBanner is bool &&
             request.resource.data.startedAt is string &&
             request.resource.data.lastActiveAt is string &&
             (!('completedAt' in request.resource.data) ||
               request.resource.data.completedAt == null ||
               request.resource.data.completedAt is string) &&
             (!('stepData' in request.resource.data) || request.resource.data.stepData is map);
    }

    // -------------------------------------------------------------------------
    // User Profiles (/users/{userId})
    // -------------------------------------------------------------------------
    match /users/{userId} {
      allow read: if isUser(userId) || isPlatformAdmin();
      // Profiles are synchronized by a server command so callers cannot add
      // trusted-looking plan, role, or provisioning fields to their profile.
      allow create, update, delete: if false;
    }

    // -------------------------------------------------------------------------
    // Global Master Frameworks Library (/frameworks/{frameworkId})
    // -------------------------------------------------------------------------
    match /frameworks/{frameworkId} {
      allow read: if isAuthenticated();
      allow write: if false;

      match /requirements/{requirementId} {
        allow read: if isAuthenticated();
        allow write: if false;
      }

      match /master_controls/{controlId} {
        allow read: if isAuthenticated();
        allow write: if false;
      }

      match /mappings/{mappingId} {
        allow read: if isAuthenticated();
        allow write: if false;
      }
    }

    // -------------------------------------------------------------------------
    // Global Cross-Framework Control Mappings & Harmonization
    // -------------------------------------------------------------------------
    match /control_mappings/{mappingId} {
      allow read: if isAuthenticated();
      allow write: if false;
    }

    match /scope_questionnaires/{questionnaireId} {
      allow read: if isAuthenticated();
      allow write: if false;

      match /questions/{questionId} {
        allow read: if isAuthenticated();
        allow write: if false;
      }
    }

    match /applicability_rules/{ruleId} {
      allow read: if isAuthenticated();
      allow write: if false;
    }

    // -------------------------------------------------------------------------
    // Invitations (/invitations/{invitationId})
    // -------------------------------------------------------------------------
    match /invitations/{invitationId} {
      allow read: if isAuthenticated() && (
        ('email' in request.auth.token &&
         request.auth.token.get('email_verified', false) == true &&
         'email' in resource.data &&
         resource.data.email == request.auth.token.email) ||
        ('tenantId' in resource.data && isTenantAdmin(resource.data.tenantId))
      );
      // Creating, accepting, or canceling invites is routed through Cloud Functions
      allow write: if false;
    }

    // Provisioning entitlements, counters, and idempotency receipts are a
    // server-only billing/security boundary. Firebase Auth claims alone never
    // grant browser access to these records.
    match /tenant_creation_quotas/{userId} {
      allow read, write: if false;

      match /provisioning_receipts/{receiptId} {
        allow read, write: if false;
      }
    }

    // -------------------------------------------------------------------------
    // Tenant Root & Subcollections (/tenants/{tenantId}/...)
    // -------------------------------------------------------------------------
    match /tenants/{tenantId} {
      allow get: if isTenantMember(tenantId);
      allow list: if isPlatformAdmin();
      // Tenant creation and archival must run via Cloud Functions
      allow create, update, delete: if false;

      // Memberships
      match /memberships/{memberUserId} {
        allow read: if isTenantMember(tenantId);
        // Direct client role modification is prohibited; handled via Cloud Functions
        allow create, update, delete: if false;
      }

      // Onboarding State & Persona Progress (/tenants/{tenantId}/onboarding_state/{userId})
      match /onboarding_state/{onboardingUserId} {
        allow read: if isTenantMember(tenantId) && (request.auth.uid == onboardingUserId || isTenantAdmin(tenantId));
        allow create, update: if isTenantMember(tenantId) && validPersonalOnboardingState(tenantId, onboardingUserId);
        allow delete: if false;
      }

      // Audit Logs (Strictly Append-Only via server or audited create)
      match /audit_logs/{logId} {
        allow read: if hasAnyRole(tenantId, ['tenant_admin', 'compliance_manager', 'auditor', 'security_manager']);
        // Modifying or deleting audit records is forbidden under all circumstances
        allow update, delete: if false;
        allow create: if false; // Audit logs written exclusively via Cloud Functions Admin SDK
      }

      // Idempotency receipts can contain command results and audit anchors.
      // They are internal server records, not a client-facing activity feed.
      match /command_receipts/{commandId} {
        allow read, write: if false;
      }

      match /command_outbox/{eventId} {
        allow read, write: if false;
      }

      // Controls
      match /controls/{controlId} {
        allow read: if isTenantMember(tenantId);
        allow create, update, delete: if false;

        match /reviews/{reviewId} {
          allow read: if isTenantMember(tenantId);
          allow create, update, delete: if false;
        }
      }

      // Evidence Repository
      match /evidence/{evidenceId} {
        allow read: if isTenantMember(tenantId);
        // Evidence metadata and lifecycle changes are server-only. Client upload,
        // versioning and approval remain disabled until verified upload sessions
        // bind records to immutable Storage object generations.
        allow create, update, delete: if false;

        match /versions/{versionId} {
          allow read: if isTenantMember(tenantId);
          allow create, update, delete: if false;
        }
      }

      // Policies
      match /policies/{policyId} {
        // Full bodies and mutable lifecycle fields are projected through
        // server callables that verify the current version/receipt/audit chain.
        allow read, create, update, delete: if false;

        match /versions/{versionId} {
          allow read, create, update, delete: if false;
        }
      }

      // Risks
      match /risks/{riskId} {
        // Authoritative records are projected through bounded callables that
        // verify the current state -> version -> receipt -> audit anchor.
        allow read, create, update, delete: if false;

        match /versions/{versionId} {
          allow read, create, update, delete: if false;
        }
      }

      // Issues & Remediations
      match /issues/{issueId} {
        allow read, create, update, delete: if false;

        match /versions/{versionId} {
          allow read, create, update, delete: if false;
        }
      }

      // Tasks
      match /tasks/{taskId} {
        allow read, create, update, delete: if false;

        match /versions/{versionId} {
          allow read, create, update, delete: if false;
        }
      }

      // Vendors & Third Parties (Commercial Master)
      match /vendors/{vendorId} {
        allow read: if isTenantMember(tenantId);
        allow create, update, delete: if false;
      }

      // Data Processor Profiles (Privacy & Data Processing Overlay)
      match /processor_profiles/{profileId} {
        allow read: if isTenantMember(tenantId);
        allow create, update, delete: if false;
      }

      // Cross-Border Transfer Arrangements
      match /transfer_arrangements/{arrangementId} {
        allow read: if isTenantMember(tenantId);
        allow create, update, delete: if false;
      }

      // Processor Certifications & Third-Party Assurance
      match /processor_certifications/{certId} {
        allow read: if isTenantMember(tenantId);
        allow create, update, delete: if false;
      }

      // Processor & Vendor Assessments (Due Diligence & Periodic Questionnaires)
      match /processor_assessments/{assessmentId} {
        allow read: if isTenantMember(tenantId);
        allow create, update, delete: if false;
      }

      // Tenant-Scoped Questionnaire Templates
      match /questionnaire_templates/{templateId} {
        allow read: if isTenantMember(tenantId);
        allow create, update, delete: if false;
      }

      // Third-Party Assessment Campaigns
      match /assessment_campaigns/{campaignId} {
        allow read: if isTenantMember(tenantId);
        allow create, update, delete: if false;
      }

      // Third-Party Assessment Requests
      match /assessment_requests/{requestId} {
        allow read: if isTenantMember(tenantId);
        allow create, update, delete: if false;
      }

      // Recurring Assessment Schedules
      match /recurring_schedules/{scheduleId} {
        allow read: if isTenantMember(tenantId);
        allow create, update, delete: if false;
      }

      // External Assessment Submissions
      match /assessment_submissions/{submissionId} {
        allow read: if isTenantMember(tenantId);
        allow create, update, delete: if false;
      }

      // Submission Reviews
      match /submission_reviews/{reviewId} {
        allow read: if isTenantMember(tenantId);
        allow create, update, delete: if false;
      }

      // Assessment Access Tokens (Restricted Token Storage - writes via Cloud Functions only)
      match /assessment_access_tokens/{tokenId} {
        // Bearer-token hashes, respondent PII, access telemetry and verification
        // metadata are never exposed to an untrusted browser. Authorized staff
        // consume redacted request status through server-side query commands.
        allow read, write: if false;
      }

      // Systems & Assets
      match /system_assets/{assetId} {
        allow read: if isTenantMember(tenantId);
        allow create, update, delete: if false;
      }

      // Structured Certifications & External Assurance Records
      match /certifications/{certId} {
        // Mutable record fields are exposed only through server projections
        // that verify the current version, receipt, and audit anchor.
        allow read, create, update, delete: if false;

        match /versions/{versionId} {
          allow read, create, update, delete: if false;
        }
      }

      // GDPR: ROPA Entries
      match /ropa_entries/{ropaId} {
        allow read: if isTenantMember(tenantId);
        allow create, update, delete: if false;
      }

      // GDPR: DPIA Assessments
      match /dpia_assessments/{dpiaId} {
        allow read: if isTenantMember(tenantId);
        allow create, update, delete: if false;
      }

      // GDPR: TIA Assessments
      match /tia_assessments/{tiaId} {
        allow read: if isTenantMember(tenantId);
        allow create, update, delete: if false;
      }

      // GDPR: Personal Data Breaches
      match /breaches/{breachId} {
        allow read: if hasAnyRole(tenantId, ['tenant_admin', 'privacy_manager', 'security_manager', 'compliance_manager', 'auditor']);
        allow create, update, delete: if false;
      }

      // GDPR: DSR Requests
      match /dsr_requests/{dsrId} {
        allow read: if isTenantMember(tenantId);
        allow create, update, delete: if false;
      }

      // EU AI Act: AI Systems Register
      match /ai_systems/{systemId} {
        allow read: if isTenantMember(tenantId);
        allow create, update, delete: if false;

        match /substantial_changes/{changeId} {
          allow read: if isTenantMember(tenantId);
          allow create, update, delete: if false;
        }

        match /post_market_logs/{logId} {
          allow read: if isTenantMember(tenantId);
          allow create, update, delete: if false;
        }
      }

      // EU AI Act: AI Assessments (Risk, Impact, FRIA)
      match /ai_assessments/{assessmentId} {
        allow read: if isTenantMember(tenantId);
        allow create, update, delete: if false;
      }

      // EU AI Act: AI Incidents
      match /ai_incidents/{incidentId} {
        allow read: if isTenantMember(tenantId);
        allow create, update, delete: if false;
      }

      // EU Data Act: Data Assets & Governance
      match /data_act_assets/{dataAssetId} {
        allow read: if isTenantMember(tenantId);
        allow create, update, delete: if false;
      }

      // EU Data Act: Data Sharing Requests
      match /data_sharing_requests/{requestId} {
        allow read: if isTenantMember(tenantId);
        allow create, update, delete: if false;
      }

      // EU Data Act: Switching Dependencies
      match /switching_dependencies/{dependencyId} {
        allow read: if isTenantMember(tenantId);
        allow create, update, delete: if false;
      }

      // ISO 27001 & ISO 42001 Management Layer Collections
      match /iso_scope_statements/{scopeId} {
        allow read: if isTenantMember(tenantId);
        allow create, update, delete: if false;
      }

      match /iso_objectives/{objId} {
        allow read: if isTenantMember(tenantId);
        allow create, update, delete: if false;
      }

      match /iso_soa_entries/{soaId} {
        allow read: if isTenantMember(tenantId);
        allow create, update, delete: if false;
      }

      match /iso_internal_audits/{auditId} {
        allow read: if isTenantMember(tenantId);
        allow create, update, delete: if false;

        match /findings/{findingId} {
          allow read: if isTenantMember(tenantId);
          allow create, update, delete: if false;
        }
      }

      match /iso_management_reviews/{reviewId} {
        allow read: if isTenantMember(tenantId);
        allow create, update, delete: if false;
      }

      // Materialized Summary Metrics
      match /summary_metrics/{metricId} {
        allow read: if isTenantMember(tenantId);
        allow write: if false; // Materialized asynchronously by Cloud Functions Admin SDK
      }

      // Notifications (In-App & Lifecycle Alerts)
      match /notifications/{notificationId} {
        allow read: if isTenantMember(tenantId) && resource.data.recipientId == request.auth.uid;
        allow create, update, delete: if false;
      }

      // Export Jobs
      match /export_jobs/{jobId} {
        allow read: if isTenantMember(tenantId) && (
          resource.data.requestedBy == request.auth.uid ||
          isTenantAdmin(tenantId)
        );
        allow create, update, delete: if false;
      }

      // Framework Adoption & Scoping
      match /adopted_frameworks/{frameworkId} {
        allow read: if isTenantMember(tenantId);
        allow create, update, delete: if false;
      }

      // Requirement Applicability & Scoping Decisions
      match /requirement_applicability/{reqId} {
        allow read: if isTenantMember(tenantId);
        allow create, update, delete: if false;
      }

      // Tenant Scope Profiles
      match /scope_profiles/{profileId} {
        allow read: if isTenantMember(tenantId);
        allow create, update, delete: if false;
      }

      // Tenant Scope Facts
      match /scope_facts/{factId} {
        allow read: if isTenantMember(tenantId);
        allow create, update, delete: if false;
      }

      // Tenant Scope Answers
      match /scope_answers/{answerId} {
        allow read: if isTenantMember(tenantId);
        allow create, update, delete: if false;
      }

      // Tenant Applicability Decisions
      match /applicability_decisions/{decisionId} {
        allow read: if isTenantMember(tenantId);
        allow create, update, delete: if false;
      }

      // Tenant Requirement Instances
      match /requirement_instances/{instanceId} {
        allow read: if isTenantMember(tenantId);
        allow create, update, delete: if false;
      }

      // Tenant Control Mappings
      match /control_mappings/{mappingId} {
        allow read: if isTenantMember(tenantId);
        allow create, update, delete: if false;
      }

      // Tenant Statutory Obligation Flags
      match /statutory_obligations/{obligationId} {
        allow read: if isTenantMember(tenantId);
        allow create, update, delete: if false;
      }
    }

    // Root-Level Assessment Access Tokens (Restricted - Server-Side Admin SDK Access Only)
    match /assessment_access_tokens/{tokenId} {
      allow read, write: if false;
    }
  }
}
